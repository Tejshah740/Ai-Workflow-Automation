# Application Configuration
APP_NAME="Workflow Automation System"
DEBUG=False

# Database Configuration (PostgreSQL)
# For local development:
DATABASE_URL=postgresql://workflow_user:workflow_pass@localhost:5432/workflow_db
# For Docker Compose environment:
# DATABASE_URL=postgresql://workflow_user:workflow_pass@postgres:5432/workflow_db

# Redis Configuration
# For local development:
REDIS_URL=redis://localhost:6379/0
# For Docker Compose environment:
# REDIS_URL=redis://redis:6379/0

# CORS Configuration (JSON array of allowed origins)
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

# JWT Authentication
JWT_SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# File Upload / Storage Configuration
# For local development:
UPLOAD_DIR=./uploads
# For Docker Compose environment:
# UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE_BYTES=10485760

# AI Extraction & Confidence Scoring
CONFIDENCE_THRESHOLD=0.6

# SMTP / Email Configuration
# For local development with MailHog:
# SMTP_HOST=localhost
# For Docker Compose with MailHog:
# SMTP_HOST=mailhog
# Leave empty to log to console instead of sending:
SMTP_HOST=
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@workflow.local
SMTP_USE_TLS=False
